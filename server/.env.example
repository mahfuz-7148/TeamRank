MONGO_URI=mongodb://localhost:27017/teamrank
ADMIN_KEY=change-me-to-a-strong-secret
# Signs the httpOnly auth cookie — use a long random string (>= 16 chars)
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Comma-separated list is supported, e.g. https://teamrank.example.com,http://localhost:3000
CLIENT_URL=http://localhost:3000
